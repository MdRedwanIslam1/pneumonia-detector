# Single-container cloud deployment for Streamlit and FastAPI.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    MPLCONFIGDIR=/tmp/matplotlib \
    HOME=/home/user \
    MODEL_PATH=/home/user/app/models/densenet121_advanced_best.keras \
    PREDICTION_THRESHOLD=0.5 \
    INTERNAL_API_PORT=8000 \
    PORT=7860

# libgomp is needed by TensorFlow; tini forwards shutdown signals correctly.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 user

WORKDIR /home/user/app

COPY requirements-api.txt requirements-frontend.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-api.txt -r requirements-frontend.txt

# Copy only inference and interface files. Training data is excluded.
COPY --chown=1000:1000 api ./api
COPY --chown=1000:1000 frontend/streamlit_app.py ./frontend/streamlit_app.py
COPY --chown=1000:1000 .streamlit/config.toml ./.streamlit/config.toml
COPY --chown=1000:1000 \
    src/__init__.py \
    src/preprocess.py \
    src/gradcam.py \
    src/predict.py \
    ./src/
COPY --chown=1000:1000 \
    models/densenet121_advanced_best.keras \
    ./models/densenet121_advanced_best.keras
COPY --chown=1000:1000 scripts/start_deployment.sh ./scripts/start_deployment.sh

RUN chmod +x ./scripts/start_deployment.sh

USER user

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import os, urllib.request; port=os.environ.get('PORT', '7860'); urllib.request.urlopen(f'http://127.0.0.1:{port}/_stcore/health', timeout=4).read()"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./scripts/start_deployment.sh"]
